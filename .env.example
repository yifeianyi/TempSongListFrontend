# Songlist 模板前端环境变量配置
# 将此文件复制为 .env 并根据实际情况修改

# ============================================
# 域名到歌手的映射配置
# ============================================
# 注意：域名中的点号（.）需要替换为下划线（_）
# 例如：youyou.example.com -> youyou_example_com

# 示例 1：乐游的域名
youyou_example_com=youyou

# 示例 2：冰洁的域名
bingjie_example_com=bingjie

# 示例 3：新歌手的域名
# newartist_example_com=newartist

# ============================================
# 本地开发环境
# ============================================
# 在本地开发时，使用 localhost 或 127.0.0.1
localhost=youyou
127_0_0_1=youyou

# ============================================
# 默认歌手
# ============================================
# 当域名不匹配任何配置时，使用的默认歌手标识
# 必须确保后端 songlist/models.py 中有对应的配置
DEFAULT_ARTIST=youyou

# ============================================
# 配置说明
# ============================================
# 1. 歌手标识（youyou, bingjie 等）必须与后端 songlist/models.py
#    中的 ARTIST_CONFIG 配置一致
#
# 2. 域名格式：
#    - 环境变量名：域名中的点号替换为下划线
#    - 例如：www.example.com -> www_example_com
#
# 3. 访问优先级：
#    a. 域名映射（从环境变量中查找）
#    b. URL 参数（?artist=xxx）
#    c. 默认值（DEFAULT_ARTIST）
#
# 4. 测试方法：
#    - 通过域名访问：http://youyou.example.com
#    - 通过参数访问：http://localhost:5173?artist=bingjie
#
# 5. 添加新歌手：
#    a. 在后端 songlist/models.py 中添加配置
#    b. 运行数据库迁移
#    c. 在此文件中添加域名映射
#    d. 配置 Nginx
#    e. 导入数据

# ============================================
# 生产环境示例
# ============================================
# 如果您有多个域名，可以在这里配置：
#
# youyou_com=youyou
# www_youyou_com=youyou
# bingjie_com=bingjie
# www_bingjie_com=bingjie
# newartist_com=newartist
# www_newartist_com=newartist
#
# DEFAULT_ARTIST=youyou